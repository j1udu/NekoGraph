NEKOGRAPH_HOST=127.0.0.1
NEKOGRAPH_PORT=8080
NEKOGRAPH_WEBSOCKET_PATH=/onebot/v11/ws
# NEKOGRAPH_ACCESS_TOKEN=replace-with-the-same-token-used-by-napcat
NEKOGRAPH_CHECKPOINT_PATH=data/checkpoints.sqlite
NEKOGRAPH_GROUP_CONVERSATION_MODE=per_user
NEKOGRAPH_GROUP_WAKE_PREFIXES='["neko"]'

# Use fake for deterministic local development, or openai_compatible for a real provider.
NEKOGRAPH_MODEL_BACKEND=fake
# NEKOGRAPH_LLM_MODEL=your-model-name
NEKOGRAPH_LLM_BASE_URL=https://api.openai.com/v1
# NEKOGRAPH_LLM_API_KEY=replace-with-your-provider-key
NEKOGRAPH_LLM_TEMPERATURE=0
NEKOGRAPH_LLM_TIMEOUT_SECONDS=30
NEKOGRAPH_TOOL_SANDBOX_PATH=data/tool-sandbox
NEKOGRAPH_TOOL_EXECUTION_LEDGER_PATH=data/tool-executions.sqlite
NEKOGRAPH_TOOL_PERMISSIONS='["demo_file:write"]'
NEKOGRAPH_ALLOW_DANGEROUS_TOOLS=false
NEKOGRAPH_TOOL_APPROVAL_TTL_SECONDS=900
